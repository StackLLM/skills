# Copier ce fichier en infra/.env sur le serveur. Il n'entre jamais dans Git.
# Une ligne = CLE=valeur, sans espace dans la clé : Docker refuse le reste.

# Domaine, sans https:// (exemple : exemple.ma). Caddy prend le certificat.
SITE_DOMAINE=
# Image à lancer. latest : la dernière de main. Un tag (v1.2.0 ou sha-…) pour revenir en arrière.
IMAGE=ghcr.io/{{DEPOT_PRINCIPAL_MINUSCULES}}:latest

# Adresse publique, avec https://, sans / à la fin.
{{PREFIXE}}_ORIGINE=
# Niveau de journal : info en production.
{{PREFIXE}}_JOURNAL=info
