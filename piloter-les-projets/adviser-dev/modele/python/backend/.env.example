# Copier en backend/.env pour le poste du dev. Il n'entre jamais dans Git.
# Une ligne = CLE=valeur, sans espace dans la clé (Python et Docker lisent le même fichier).

# production en ligne, developpement sur le poste.
{{PREFIXE}}_ENVIRONNEMENT=developpement
# Port du service ({{PORT}} par défaut) et adresse d'écoute (0.0.0.0 en conteneur).
{{PREFIXE}}_PORT={{PORT}}
{{PREFIXE}}_HOTE=127.0.0.1
# Adresse publique, avec https://, sans / final. Obligatoire en production.
{{PREFIXE}}_ORIGINE=
# 1 seulement si un proxy de confiance est devant (Caddy, tunnel, hébergeur) : on lit alors X-Forwarded-For.
{{PREFIXE}}_PROXY=0
# Dossier des données (base, fichiers envoyés). Par défaut : backend/data.
{{PREFIXE}}_DONNEES=
# Niveau de journal : debug, info, warning, error.
{{PREFIXE}}_JOURNAL=debug
